# -------------------------------------------------------------
# 全運具快遞媒合平台 (Along-The-Way Courier Platform) - 環境變數模板
# -------------------------------------------------------------

# 伺服器監聽連接埠 (雲端 PaaS 如 Render/Zeabur 會自動覆寫 PORT)
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# 空間地理資料庫 (PostgreSQL + PostGIS)
# 本機開發: postgresql://courier_admin:courier_secret_password@localhost:5432/courier_platform
# 雲端生產: 由雲端資料庫（如 Zeabur PostgreSQL、Neon、Supabase）提供
DATABASE_URL=postgresql://courier_admin:courier_secret_password@localhost:5432/courier_platform

# 即時軌跡與快取資料庫 (Redis)
# 本機開發: redis://localhost:6379
# 雲端生產: 由 Upstash 或 Zeabur Redis 提供
REDIS_URL=redis://localhost:6379

# 金流服務設定 (第三步啟用：綠界 ECPay / 藍新 NewebPay / Stripe)
PAYMENT_GATEWAY_PROVIDER=mock
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=

# 安全通訊金鑰 (JWT / Escrow Signature)
JWT_SECRET=super_secret_jwt_key_change_in_production
ESCROW_ENCRYPTION_KEY=escrow_secret_signing_key_32bytes
